{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Route",
  "type": "object",
  "required": ["route_id", "ordered_stops", "segments"],
  "properties": {
    "route_id": { "type": "string" },
    "name": { "type": "string" },
    "ordered_stops": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "distance_km"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "distance_km": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
